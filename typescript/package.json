{
  "name": "fellowship-data",
  "version": "0.3.0",
  "description": "Fellowship game data — heroes, abilities, items, enemies — as a TypeScript package",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevs-enterprises/fellowship-data.git",
    "directory": "typescript"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./generated/*": "./dist/generated/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0"
  }
}
